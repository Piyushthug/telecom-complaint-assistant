{
  "metadata": {
    "version": "1.0",
    "description": "AI evaluation dataset for telecom complaint assistant",
    "num_test_cases": 20,
    "categories": ["billing", "outage", "slow_internet", "refund", "general"],
    "created_date": "2026-10-30"
  },
