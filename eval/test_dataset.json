      "complaint_text": "I was overcharged $50 on my bill this month. I want a refund immediately.",
      "customer_id": "CUST_EVAL_001",
      "channel": "chat",
      "expected": {
        "sentiment": "negative",
        "category": "billing",
        "should_escalate": false,
        "response_requirements": {
          "has_policy_citation": true,
          "mentions_refund_process": true,
          "no_specific_amount_promised": true,
          "acknowledges_issue": true
        },
        "failure_modes": ["hallucinated_refund", "vague_timeline"]
      }
    },
